# Copy to .env (git-ignored) and adjust.

# Local dev with the OpenTelemetry Demo: makes `docker compose up -d` use the demo stack.
# Remove this line to run only our services against another system.
COMPOSE_FILE=compose.demo.yaml

# Optional: a full clone of the demo to use instead of deploy/demo/upstream.
# OTEL_DEMO_DIR=../opentelemetry-demo

# Profile file in profiles/ describing the monitored system.
ONCALL_PROFILE=otel-demo.yaml

# Azure OpenAI for the agent. Without endpoint + deployment, investigations still run and end in
# an inconclusive report written by code. Without an API key, the Azure login is used
# (needs the `entra` extra installed).
# ONCALL_AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# ONCALL_AZURE_OPENAI_API_KEY=
# ONCALL_AGENT_DEPLOYMENT=<deployment name>
# ONCALL_AZURE_OPENAI_API_VERSION=2024-10-21
# USD per million tokens of that deployment, for the $0.50 cost budget (defaults: gpt-4.1-mini).
# ONCALL_AGENT_PRICE_INPUT_PER_MTOK=0.40
# ONCALL_AGENT_PRICE_OUTPUT_PER_MTOK=1.60
