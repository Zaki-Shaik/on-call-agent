# Copy to .env (git-ignored) and adjust.

# Local dev with the OpenTelemetry Demo: makes `docker compose up -d` use the demo stack.
# Remove this line to run only our services against another system.
COMPOSE_FILE=compose.demo.yaml

# Path to your clone of https://github.com/open-telemetry/opentelemetry-demo at tag 3.1.0.
OTEL_DEMO_DIR=../opentelemetry-demo

# Profile file in profiles/ describing the monitored system.
ONCALL_PROFILE=otel-demo.yaml
