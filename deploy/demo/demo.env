# Overrides for the demo's own .env (loaded after it).
# The demo's .env pulls `latest` images; pin them to the copied release.
DEMO_VERSION=3.1.0
IMAGE_VERSION=3.1.0
# The demo's .env expands service.version from its own IMAGE_VERSION (3.0.0) before this
# file loads, so restate it; otherwise every service reports the wrong version.
OTEL_RESOURCE_ATTRIBUTES=service.namespace=opentelemetry-demo,service.version=3.1.0
